{
  "name": "dsh-plugin-guardkit",
  "version": "0.1.1",
  "description": "Watches every installed plugin, scores its runtime risk, and lets you contain it from one panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-monitor",
    "security",
    "risk",
    "audit"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CONTRACT.md",
    "LICENSE",
    "market"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karla-zhang/dsh-plugin-guardkit.git"
  },
  "homepage": "https://github.com/karla-zhang/dsh-plugin-guardkit",
  "bugs": {
    "url": "https://github.com/karla-zhang/dsh-plugin-guardkit/issues"
  },
  "author": "karla-zhang"
}
